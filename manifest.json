{
  "manifest_version": 3,
  "name": "Springbored",
  "version": "1.0.0",
  "description": "On Infosys Springboard, jumps each video to its last few seconds, lets it finish, then moves on to the next item.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Springbored",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
